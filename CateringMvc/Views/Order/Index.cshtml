@model OrderCreateViewModel
@{
    ViewData["Title"] = "Order";
    var inv = CultureInfo.InvariantCulture;
    var p = Model.Prices;
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    var dateVal = Model.DeliveryDate.ToString("yyyy-MM-dd");
    var timeVal = Model.DeliveryTime.HasValue ? Model.DeliveryTime.Value.ToString(@"hh\:mm") : "";
    var advanceVal = Model.AdvancePaid.HasValue ? Model.AdvancePaid.Value.ToString("0.##", inv) : "";

    var itemsJson = System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(i => new
    {
        type = i.ItemType.ToString(),
        rice = i.RiceKg,
        meat = i.MeatKg,
        qty = i.QuantityKg,
        cooking = i.CookingCharge,
        other = i.OtherCharge,
        raita = i.RaitaKg
    }));

    var orderNo = TempData["OrderNo"] as string;
    var orderName = TempData["OrderName"] as string;
    var orderItems = (TempData["OrderItems"] as string ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries);
    var orderTotal = TempData["OrderTotal"] as string;
    var orderPaid = TempData["OrderPaid"] as string;
    var orderRemaining = TempData["OrderRemaining"] as string;
    var orderPayClass = TempData["OrderPayClass"] as string ?? "pay-red";
    var orderWhen = TempData["OrderWhen"] as string;
}

<h2 class="fw-bold mb-3">New Order</h2>

@{
    var tierJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, Dictionary<string, decimal>>
    {
        ["Biryani"] = new() { ["8"] = p.BiryaniPrice8Kg, ["10"] = p.BiryaniPrice10Kg, ["12"] = p.BiryaniPrice12Kg, ["14"] = p.BiryaniPrice14Kg },
        ["Zarda"] = new() { ["8"] = p.ZardaPrice8Kg, ["10"] = p.ZardaPrice10Kg, ["12"] = p.ZardaPrice12Kg, ["14"] = p.ZardaPrice14Kg },
        ["ChanaDaig"] = new() { ["8"] = p.ChanaDaigPrice8Kg, ["10"] = p.ChanaDaigPrice10Kg, ["12"] = p.ChanaDaigPrice12Kg, ["14"] = p.ChanaDaigPrice14Kg },
        ["WhiteRice"] = new() { ["8"] = p.WhiteRicePrice8Kg, ["10"] = p.WhiteRicePrice10Kg, ["12"] = p.WhiteRicePrice12Kg, ["14"] = p.WhiteRicePrice14Kg },
        ["SimpleRice"] = new() { ["8"] = p.SimpleRicePrice8Kg, ["10"] = p.SimpleRicePrice10Kg, ["12"] = p.SimpleRicePrice12Kg, ["14"] = p.SimpleRicePrice14Kg },
        ["GurChawal"] = new() { ["8"] = p.GurChawalPrice8Kg, ["10"] = p.GurChawalPrice10Kg, ["12"] = p.GurChawalPrice12Kg, ["14"] = p.GurChawalPrice14Kg },
    });
}
<form id="orderForm" asp-action="Create" method="post" novalidate
      data-tiers="@tierJson"
      data-b-meat="@p.BiryaniMeatPerKg.ToString(inv)"
      data-b-cook="@p.BiryaniCookingCharge.ToString(inv)"
      data-z-cook="@p.ZardaCookingCharge.ToString(inv)"
      data-k-meat="@p.KormaMeatPerKg.ToString(inv)"
      data-k-cook="@p.KormaCookingPerKg.ToString(inv)"
      data-w-cook="@p.WhiteRiceCookingCharge.ToString(inv)"
      data-s-cook="@p.SimpleRiceCookingCharge.ToString(inv)"
      data-g-cook="@p.GurChawalCookingCharge.ToString(inv)"
      data-bk-meat="@p.BeefKormaMeatPerKg.ToString(inv)"
      data-bk-cook="@p.BeefKormaCookingPerKg.ToString(inv)"
      data-r-meat="@p.RoastMeatPerKg.ToString(inv)"
      data-raita="@p.RaitaPerKg.ToString(inv)"
      data-r-cook="@p.RoastCookingPerKg.ToString(inv)"
      data-h-kg="@p.HaleemPerKg.ToString(inv)"
      data-h-cook="@p.HaleemCookingCharge.ToString(inv)"
      data-c-cook="@p.ChanaDaigCookingCharge.ToString(inv)">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div id="clientError" class="alert alert-danger d-none"></div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card mb-4">
                <div class="card-header">1. Items</div>
                <div class="card-body">
                    <p class="text-muted small mb-2">Ek order mein kai items add kar sakte hain. Fixed-size items show "Other charges" (pre-filled from Price Adjustment, editable). Korma, Roast and Haleem use the cooking rate from Price Adjustment automatically, and you can add "Other charges" on top.</p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-outline-danger" data-add="Biryani">+ 🍚 Biryani Daig</button>
                        <button type="button" class="btn btn-outline-success" data-add="Zarda">+ 🍮 Zarda</button>
                        <button type="button" class="btn btn-outline-warning text-dark" data-add="Korma">+ 🍲 Korma</button>
                        <button type="button" class="btn btn-outline-danger" data-add="BeefKorma">+ 🥩 Beef Korma</button>
                        <button type="button" class="btn btn-outline-danger" data-add="Roast">+ 🍗 Roast</button>
                        <button type="button" class="btn btn-outline-success" data-add="WhiteRice">+ 🍚 White Rice</button>
                        <button type="button" class="btn btn-outline-success" data-add="SimpleRice">+ 🍚 Chinese Rice</button>
                        <button type="button" class="btn btn-outline-success" data-add="GurChawal">+ 🍯 Gor Wala Chawal</button>
                        <button type="button" class="btn btn-outline-secondary" data-add="Haleem">+ 🥣 Haleem</button>
                        <button type="button" class="btn btn-outline-dark" data-add="ChanaDaig">+ 🫘 Chana Wala Chawal</button>
                    </div>

                    <div id="itemsContainer"></div>

                    <div class="total-box mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Total Price</span>
                            <span class="total-amount" id="totalAmount">Rs 0</span>
                        </div>
                        <hr class="my-2" />
                        <div class="row g-2 align-items-center">
                            <div class="col-sm-6">
                                <label class="form-label mb-1 fw-semibold" for="advancePaid">Advance payment (customer ne diye)</label>
                                <div class="input-group">
                                    <span class="input-group-text">Rs</span>
                                    <input type="number" id="advancePaid" name="AdvancePaid" value="@advanceVal" class="form-control" min="0" step="any" placeholder="0" />
                                </div>
                                @Html.ValidationMessage("AdvancePaid", new { @class = "text-danger small" })
                            </div>
                            <div class="col-sm-6 text-sm-end">
                                <div class="small text-muted">Baqi (remaining)</div>
                                <div class="fs-4 fw-bold" id="remainingAmount">Rs 0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="card-header">2. Order Date &amp; Time</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="deliveryDate">Date</label>
                            <input type="date" id="deliveryDate" name="DeliveryDate" value="@dateVal" min="@todayStr" class="form-control" required />
                            @Html.ValidationMessage("DeliveryDate", new { @class = "text-danger small" })
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="deliveryTime">Time</label>
                            <input type="time" id="deliveryTime" name="DeliveryTime" value="@timeVal" class="form-control" required />
                            @Html.ValidationMessage("DeliveryTime", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="form-text mt-2">Order se <strong>1 ghanta pehle</strong> alert aayega: "is customer ka order ready karo".</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">3. Customer Details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="CustomerName">Customer name</label>
                        <input asp-for="CustomerName" class="form-control" maxlength="100" required />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Phone1">Phone number 1</label>
                        <input asp-for="Phone1" type="tel" class="form-control" pattern="[0-9+\-\s]{10,15}" placeholder="03xx-xxxxxxx" required />
                        <span asp-validation-for="Phone1" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Phone2">Phone number 2 <span class="text-muted">(optional)</span></label>
                        <input asp-for="Phone2" type="tel" class="form-control" pattern="[0-9+\-\s]{10,15}" placeholder="03xx-xxxxxxx" />
                        <span asp-validation-for="Phone2" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="Address">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="3" maxlength="300" required></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <button type="submit" id="submitBtn" class="btn btn-gold btn-lg w-100">
                        <i class="bi bi-check2-circle"></i> Order Fulfill
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<script type="application/json" id="initialItems">@Html.Raw(itemsJson)</script>

@if (!string.IsNullOrEmpty(orderNo))
{
    <!-- Success popup (oper dikhta hai) -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true" data-show="1">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-check-circle-fill"></i> Order Fulfilled</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="fs-5 mb-2">Order <strong>#@orderNo</strong> save ho gaya hai.</p>
                    <ul class="list-unstyled mb-2">
                        <li><strong>Customer:</strong> @orderName</li>
                        <li><strong>Order time:</strong> @orderWhen</li>
                    </ul>
                    <div class="border rounded p-2 small mb-3">
                        @foreach (var line in orderItems)
                        {
                            <div>• @line</div>
                        }
                    </div>
                    <table class="table table-sm mb-0 popup-pay @orderPayClass">
                        <tr><td>Total</td><td class="text-end fw-bold">Rs @orderTotal</td></tr>
                        <tr><td>Advance</td><td class="text-end">Rs @orderPaid</td></tr>
                        <tr><td>Remaining</td><td class="text-end fw-bold">Rs @orderRemaining</td></tr>
                    </table>
                    <div class="alert alert-warning mt-3 mb-0">Ye order <strong>Pending Orders</strong> mein hai. Order dene ke baad wahan <strong>Done</strong> dabayein.</div>
                </div>
                <div class="modal-footer">
                    <a href="/Order/Receipt/@orderNo?print=1" target="_blank" class="btn btn-gold"><i class="bi bi-printer-fill"></i> Print Receipt</a>
                    <a href="/PendingOrders" class="btn btn-outline-secondary">Pending Orders</a>
                    <button type="button" class="btn btn-main" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/order.js"></script>
}

@model List<Order>
@{
    ViewData["Title"] = "Pending Orders";
    var now = DateTime.Now;
    var msg = TempData["Msg"] as string;
    var grandTotal = Model.Sum(o => o.TotalPrice).ToString("N0");
    var grandRemaining = Model.Sum(o => o.Remaining).ToString("N0");

    string Left(DateTime when)
    {
        var m = (int)Math.Round((when - now).TotalMinutes);
        if (m < 0) return "Late";
        if (m <= 60) return $"{m} min baqi";
        var h = m / 60;
        if (h < 24) return $"{h} ghanta {m % 60} min baqi";
        return $"{h / 24} din baad";
    }
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
    <h2 class="fw-bold mb-0">Pending Orders</h2>
    <a href="/Order" class="btn btn-gold"><i class="bi bi-plus-circle"></i> Naya Order</a>
</div>
<p class="text-muted">Har naya order pehle yahan aata hai, date &amp; time ke hisab se (jo order sab se nazdeek hai wo sab se oper). Order dene ke baad <strong>Done</strong> dabayein, wo Complete Orders mein chala jayega. Time se 1 ghanta pehle alert aata hai.</p>

@{
    decimal tMeat = ViewBag.TodayMeatTotal ?? 0m, tPending = ViewBag.TodayMeatPending ?? 0m, tDone = ViewBag.TodayMeatDone ?? 0m;
    var breakdown = (List<KeyValuePair<string, decimal>>)(ViewBag.TodayMeatBreakdown ?? new List<KeyValuePair<string, decimal>>());
}
<div class="card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-4">
        <div>
            <div class="text-muted small text-uppercase fw-semibold">Meat today (@DateTime.Today.ToString("dd MMM"))</div>
            <div class="total-amount">@tMeat.ToString("0.##") kg</div>
        </div>
        <div>
            <div class="text-muted small">To cook (pending)</div>
            <div class="fs-5 fw-bold text-danger">@tPending.ToString("0.##") kg</div>
        </div>
        <div>
            <div class="text-muted small">Done</div>
            <div class="fs-5 fw-bold text-success">@tDone.ToString("0.##") kg</div>
        </div>
        <div class="ms-lg-auto">
            @if (breakdown.Count == 0)
            {
                <span class="text-muted">No meat orders today (@((int)(ViewBag.TodayOrderCount ?? 0)) order(s) today)</span>
            }
            else
            {
                foreach (var kv in breakdown)
                {
                    <span class="badge text-bg-light border me-1">@kv.Key: @kv.Value.ToString("0.##") kg</span>
                }
                <div class="text-muted small mt-1">@((int)(ViewBag.TodayOrderCount ?? 0)) order(s) today</div>
            }
        </div>
    </div>
</div>

<div class="pay-legend mb-3">
    <span class="pay-chip pay-green-chip">Payment poori</span>
    <span class="pay-chip pay-yellow-chip">Kuch baqi</span>
    <span class="pay-chip pay-red-chip">Bilkul payment nahi</span>
</div>

@if (!string.IsNullOrEmpty(msg))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Order date &amp; time</th>
                    <th>Customer</th>
                    <th>Phone 1</th>
                    <th>Phone 2</th>
                    <th>Address</th>
                    <th>Items</th>
                    <th class="text-end">Payment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var minutes = (o.DeliveryDate - now).TotalMinutes;
                    <tr class="@o.RowClass">
                        <td>@o.Id</td>
                        <td class="text-nowrap">
                            <strong>@o.DeliveryDate.ToString("ddd, dd MMM yyyy")</strong><br />
                            <span class="fs-6">🕒 @o.DeliveryDate.ToString("hh:mm tt")</span><br />
                            <span class="badge @(minutes < 0 ? "text-bg-danger" : minutes <= 60 ? "text-bg-warning" : "text-bg-secondary")">@Left(o.DeliveryDate)</span>
                        </td>
                        <td>@o.CustomerName</td>
                        <td class="text-nowrap">@o.Phone1</td>
                        <td class="text-nowrap">@(o.Phone2 ?? "-")</td>
                        <td style="min-width:160px">@o.Address</td>
                        <td style="min-width:220px">
                            @if (o.Lines.Count > 0)
                            {
                                @foreach (var l in o.Lines)
                                {
                                    <div><strong>@l.Description</strong><br /><small class="text-muted">@l.Detail</small></div>
                                }
                            }
                            else
                            {
                                <strong>@o.ItemName</strong><br />
                                <small class="text-muted">@o.QuantityText</small>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div>Total: <strong>Rs @o.TotalPrice.ToString("N0")</strong></div>
                            <div>Advance: Rs @o.AdvancePaid.ToString("N0")</div>
                            <div>Baqi: <strong>Rs @o.Remaining.ToString("N0")</strong></div>
                            <span class="badge @(o.PayLabel == "Paid" ? "text-bg-success" : o.PayLabel == "Partial" ? "text-bg-warning" : "text-bg-danger")">@o.PayLabel</span>
                        </td>
                        <td class="text-nowrap">
                            <div class="d-flex flex-wrap gap-1" style="max-width:170px">
                                @if (o.Remaining > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-success" data-done data-id="@o.Id" data-customer="@o.CustomerName" data-remaining="@o.Remaining.ToString(CultureInfo.InvariantCulture)" title="Order done"><i class="bi bi-check2-circle"></i> Done</button>
                                    <button type="button" class="btn btn-sm btn-gold" data-receive data-id="@o.Id" data-customer="@o.CustomerName" data-remaining="@o.Remaining.ToString(CultureInfo.InvariantCulture)" title="Payment receive"><i class="bi bi-cash-coin"></i> Payment</button>
                                }
                                else
                                {
                                    <form asp-action="Complete" asp-route-id="@o.Id" method="post" onsubmit="return confirm('Order tayyar ho kar de diya gaya? Ye Complete Orders mein chala jayega.');">
                                        <input type="hidden" name="paymentReceived" value="true" />
                                        <button type="submit" class="btn btn-sm btn-success" title="Order done"><i class="bi bi-check2-circle"></i> Done</button>
                                    </form>
                                }
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Order" asp-action="Receipt" asp-route-id="@o.Id" target="_blank" title="Print receipt"><i class="bi bi-printer"></i></a>
                                <form asp-action="Delete" asp-route-id="@o.Id" method="post" onsubmit="return confirm('Is order ko cancel karna hai?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">Koi pending order nahi hai.</div>
    }
    <div class="card-footer d-flex flex-wrap justify-content-between gap-2">
        <span class="text-muted">@Model.Count pending order(s)</span>
        <span><strong>Total: Rs @grandTotal</strong> &nbsp;|&nbsp; <strong>Baqi: Rs @grandRemaining</strong></span>
    </div>
</div>

@await Html.PartialAsync("_PaymentModals")

@section Scripts {
    <script src="~/js/payments.js"></script>
}
